{
  "name": "geostrix",
  "version": "0.1.6",
  "description": "3D drillhole & geochemistry explorer",
  "author": "Matt Mendes",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "build:web": "vite build",
    "build:sidecar": "node python-sidecar/build_sidecar.js",
    "build": "vite build && electron-builder",
    "build:dir": "vite build && electron-builder --dir",
    "build:full": "npm run build:sidecar && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/exo-2": "^5.3.0",
    "d3-delaunay": "^6.0.4",
    "electron-updater": "^6.8.9",
    "geotiff": "^3.0.5",
    "lucide-react": "^0.383.0",
    "mysql2": "^3.24.2",
    "papaparse": "^5.4.1",
    "pg": "^8.11.3",
    "proj4": "^2.21.0",
    "sql.js": "^1.14.2",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^5.1.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.mendes.geostrix",
    "productName": "GeoStrix",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "python-sidecar/dist",
        "to": "python-sidecar",
        "filter": [
          "geostrix-sidecar*"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "Matt-Mendes-ai",
      "repo": "geostrix",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "allowScripts": {
    "electron@28.3.3": true,
    "esbuild@0.21.5": true
  }
}
