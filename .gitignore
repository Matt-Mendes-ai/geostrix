# Dependencies
node_modules/

# Build output
dist/
dist-electron/
release/

# Python sidecar
python-sidecar/**/__pycache__/
python-sidecar/**/*.pyc
python-sidecar/.venv/
python-sidecar/venv/
# TASKS.csv #49 — PyInstaller build output (a ~50MB frozen executable, plus its build/ cache and the
# auto-generated .spec file) — built fresh by `npm run build:sidecar` before packaging, not checked in.
python-sidecar/dist/
python-sidecar/build/
python-sidecar/*.spec

# Editor / OS cruft
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*

# Env
.env
.env.local

# Claude Code local-only settings (personal overrides, not shared with the team)
.claude/settings.local.json

# TASKS.csv is the project's internal backlog/changelog — verbatim user reports, real client/property
# names (e.g. a real database name once used in a bug report), and internal working notes not meant
# for a public repo. Untracked (not deleted) here on request — it still exists locally and code
# comments still reference "TASKS.csv #N" as their rationale trail, it's just no longer pushed.
TASKS.csv
