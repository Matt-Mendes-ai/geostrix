// geostrix.com (TASKS.csv #597) — Cloudflare Workers static assets: the website/ folder, served as is.
// There is no build step; the GeoStrix desktop app's own build (npm run build) must NOT run on Cloudflare.
// worker/contact.js runs only for /api/* (the contact form); every other path is served from website/ without it.
// Set in the Cloudflare dashboard, not here: the secret CONTACT_TO (the verified Email Routing destination the
// messages go to), and Email Routing turned on for geostrix.com. See website/README.md, "Contact form".
{
  "name": "geostrix",
  "main": "worker/contact.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./website",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    { "name": "CONTACT_EMAIL" }
  ],
  // five messages a minute per address, per Cloudflare location: plenty for a person, a wall for a script
  "ratelimits": [
    { "name": "CONTACT_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ]
}
